# Banco de dados
POSTGRES_DB=ticket_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_senha_forte

# Aplicação
# Gere com: openssl rand -base64 32
AUTH_SECRET=troque_por_secret_forte

# URL pública da aplicação (sem barra no final)
AUTH_URL=https://chamados.seudominio.com.br

# Caminho do disco de storage no host (sem barra no final)
# Ex: disco montado em /mnt/storage no Ubuntu
STORAGE_PATH=/mnt/storage/chamados
