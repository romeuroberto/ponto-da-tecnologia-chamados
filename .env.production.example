# Banco de dados
POSTGRES_DB=ticket_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_senha_forte

# Aplicação
# Gere com: openssl rand -base64 32
AUTH_SECRET=troque_por_secret_forte

# URL pública da aplicação (sem barra no final)
AUTH_URL=https://chamados.seudominio.com.br

# Caminho para os dados do PostgreSQL — usar SSD (rápido, dentro do LXC)
DB_STORAGE_PATH=/opt/chamados-data/postgres

# Caminho para os uploads de arquivos — usar HD mecânico (montado no LXC)
UPLOADS_STORAGE_PATH=/mnt/hd/chamados/uploads
