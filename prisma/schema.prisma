generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ATTENDANT
  TECHNICIAN
  CLIENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_PARTS
  CLOSED
  CANCELED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketAttendanceType {
  REMOTE
  BALCAO
  IN_STORE_EQUIPMENT
  FIELD_VISIT
}

enum HistoryEventType {
  COMMENT
  STATUS_CHANGE
  PRIORITY_CHANGE
  ASSIGNEE_CHANGE
  CREATED
  CLOSED
  REOPENED
}

enum BillingType {
  AVULSO
  CONTRATO
  GARANTIA
  CORTESIA
}

enum FinancialStatus {
  PENDENTE
  EM_ANALISE
  APROVADO
  FATURADO
  PAGO
  CANCELADO
}

enum ExpenseStatus {
  PENDENTE
  PAGA
  CANCELADA
}

enum RecurringFrequency {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum ExpenseCategory {
  ALUGUEL
  ENERGIA
  INTERNET
  TRANSPORTE
  COMBUSTIVEL
  ALIMENTACAO
  PECAS_INSUMOS
  FERRAMENTAS_EQUIPAMENTOS
  IMPOSTOS_TAXAS
  SERVICOS_TERCEIROS
  OUTROS
}

enum BillingEntryType {
  LABOR
  PART
  TRAVEL
  EXTRA
  CONSULTING
  REMOTE_SUPPORT
}

enum FiscalDocumentType {
  NFSE
  NFE
  RECIBO
  OUTRO
}

enum BillingHistoryEventType {
  SUMMARY_UPDATED
  ENTRY_CREATED
  ENTRY_UPDATED
  ENTRY_DELETED
  STATUS_UPDATED
}

enum ContractStatus {
  RASCUNHO
  ATIVO
  ENCERRADO
  EXPIRADO
}

enum ContractCoverageType {
  TOTAL
  PARCIAL
}

enum ServiceOrderStatus {
  PLANNED
  IN_EXECUTION
  PAUSED
  COMPLETED
  CANCELED
}

enum StockMovementType {
  ENTRY
  SALE_EXIT
  SERVICE_ORDER_EXIT
  ADJUSTMENT
}

enum EquipmentStatus {
  DISPONIVEL
  LOCADO
  MANUTENCAO
  BAIXADO
}

enum RentalContractStatus {
  RASCUNHO
  ATIVO
  ENCERRADO
  EXPIRADO
}

model User {
  id                    String         @id @default(cuid())
  name                  String
  email                 String         @unique
  passwordHash          String
  role                  UserRole
  active                Boolean        @default(true)
  clientId              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  clientRef             Client?        @relation("ClientPortalUser", fields: [clientId], references: [id])
  assigned              Ticket[]       @relation("TicketAssignee")
  opened                Ticket[]       @relation("TicketCreator")
  history               TicketHistory[]
  billingEntries        BillingEntry[]
  billingHistory        BillingHistory[]
  contractHistory       ContractHistory[]
  assignedServiceOrders ServiceOrder[]  @relation("ServiceOrderTechnician")
  createdServiceOrders  ServiceOrder[]  @relation("ServiceOrderCreator")
  createdSales          Sale[]          @relation("SaleCreator")
  stockMovements        StockMovement[] @relation("StockMovementCreator")
  expensesCreated       Expense[]         @relation("ExpenseCreator")
  recurringExpenses     RecurringExpense[] @relation("RecurringExpenseCreator")
  rentalContracts       RentalContract[]  @relation("RentalContractCreator")
  rentalBillings        RentalBilling[]   @relation("RentalBillingCreator")
}

model Client {
  id             String   @id @default(cuid())
  name           String
  document       String?
  contactName    String
  email          String?
  phone          String?
  notes          String?
  isReseller     Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tickets        Ticket[]
  billingProfile ClientBillingProfile?
  portalUsers    User[]   @relation("ClientPortalUser")
  sales          Sale[]
  paymentInstructions PaymentInstruction[]
  fiscalDocuments FiscalDocument[]
  contracts              ClientContract[]
  contractMonthlyBillings ContractMonthlyBilling[]
  rentalContracts        RentalContract[]
  rentalBillings         RentalBilling[]
}

model CompanyProfile {
  id                   String   @id @default(cuid())
  legalName            String
  tradeName            String?
  document             String
  stateRegistration    String?
  municipalRegistration String?
  financialEmail       String?
  phone                String?
  website              String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  notes                String?
  logoPath             String?
  signaturePath        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TicketCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  label         String
  suggestedRole String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ServiceCatalogItem {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique
  description  String?
  defaultPrice Decimal  @default(0) @db.Decimal(12, 2)
  resalePrice  Decimal? @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PartCatalogItem {
  id                String             @id @default(cuid())
  name              String
  code              String?            @unique
  description       String?
  unit              String             @default("un")
  costPrice         Decimal            @default(0) @db.Decimal(12, 2)
  unitPrice         Decimal            @default(0) @db.Decimal(12, 2)
  resalePrice       Decimal?           @db.Decimal(12, 2)
  stockQuantity     Decimal            @default(0) @db.Decimal(10, 2)
  minimumStock      Decimal?           @db.Decimal(10, 2)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  serviceOrderParts ServiceOrderPart[]
  stockMovements    StockMovement[]
  saleItems         SaleItem[]
}

model Ticket {
  id              String               @id @default(cuid())
  number          String               @unique
  title           String
  description     String
  category        String?
  attendanceType  TicketAttendanceType @default(BALCAO)
  priority        TicketPriority
  status          TicketStatus         @default(OPEN)
  requesterName   String
  requesterEmail  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?
  closingReason   String?
  checkedInAt          DateTime?
  checkedOutAt         DateTime?
  waitingPartsStartedAt DateTime?
  slaWaitingPartsMs    Int       @default(0)
  clientId        String
  assigneeId      String?
  openedById      String
  client          Client               @relation(fields: [clientId], references: [id])
  assignee        User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  openedBy        User                 @relation("TicketCreator", fields: [openedById], references: [id])
  history         TicketHistory[]
  attachments     Attachment[]
  billing         TicketBilling?
  serviceOrders   ServiceOrder[]
  fiscalDocumentLinks FiscalDocumentLink[]
  expenses        Expense[]
  equipmentId     String?
  equipment       Equipment? @relation("TicketEquipment", fields: [equipmentId], references: [id])
}

model TicketHistory {
  id                String           @id @default(cuid())
  ticketId          String
  authorId          String
  eventType         HistoryEventType
  message           String
  previousStatus    TicketStatus?
  nextStatus        TicketStatus?
  previousPriority  TicketPriority?
  nextPriority      TicketPriority?
  createdAt         DateTime         @default(now())
  ticket            Ticket           @relation(fields: [ticketId], references: [id])
  author            User             @relation(fields: [authorId], references: [id])
}

model Attachment {
  id         String   @id @default(cuid())
  ticketId   String
  fileName   String
  filePath   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
}

model ServiceOrder {
  id                   String             @id @default(cuid())
  ticketId             String
  number               String             @unique
  status               ServiceOrderStatus @default(PLANNED)
  serviceType          String?
  servicePrice         Decimal?           @db.Decimal(12, 2)
  assignedTechnicianId String?
  scheduledStartAt     DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  executionNotes       String?
  customerApprovalName String?
  customerApprovalAt   DateTime?
  createdById          String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  ticket               Ticket             @relation(fields: [ticketId], references: [id])
  assignedTechnician   User?              @relation("ServiceOrderTechnician", fields: [assignedTechnicianId], references: [id])
  createdBy            User               @relation("ServiceOrderCreator", fields: [createdById], references: [id])
  parts                ServiceOrderPart[]
}

model ServiceOrderPart {
  id                String          @id @default(cuid())
  serviceOrderId    String
  partCatalogItemId String
  partName          String
  partCode          String?
  quantity          Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice         Decimal         @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceOrder      ServiceOrder    @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  partCatalogItem   PartCatalogItem @relation(fields: [partCatalogItemId], references: [id])
}

model TicketBilling {
  id                  String           @id @default(cuid())
  ticketId            String           @unique
  billingType         BillingType      @default(AVULSO)
  financialStatus     FinancialStatus  @default(PENDENTE)
  subtotalAmount      Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal          @default(0) @db.Decimal(12, 2)
  internalNotes       String?
  // Faturamento
  invoiceNumber       String?
  invoiceDueDate      DateTime?
  // Pagamento
  paymentMethod       String?
  paymentDate         DateTime?
  paymentReference    String?
  // Cancelamento
  cancellationReason  String?
  // Timestamps automÃ¡ticos de transiÃ§Ã£o
  approvedAt          DateTime?
  invoicedAt          DateTime?
  paidAt              DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  ticket              Ticket           @relation(fields: [ticketId], references: [id])
  entries             BillingEntry[]
  history             BillingHistory[]
}

model BillingEntry {
  id              String           @id @default(cuid())
  ticketBillingId String
  entryType       BillingEntryType
  description     String
  quantity        Decimal          @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal          @default(0) @db.Decimal(12, 2)
  totalPrice      Decimal          @default(0) @db.Decimal(12, 2)
  billable        Boolean          @default(true)
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ticketBilling   TicketBilling    @relation(fields: [ticketBillingId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
}

model ClientBillingProfile {
  id                     String       @id @default(cuid())
  clientId               String       @unique
  defaultBillingType     BillingType  @default(AVULSO)
  hourlyRate             Decimal?     @db.Decimal(12, 2)
  travelRate             Decimal?     @db.Decimal(12, 2)
  defaultDiscountPercent Decimal?     @db.Decimal(5, 2)
  billingInstructions        String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  client                     Client       @relation(fields: [clientId], references: [id])
}

model ClientContract {
  id                String               @id @default(cuid())
  clientId          String
  contractNumber    String               @unique
  startDate         DateTime
  endDate           DateTime?
  status            ContractStatus       @default(ATIVO)
  coverageType      ContractCoverageType @default(PARCIAL)
  monthlyValue      Decimal?             @db.Decimal(12, 2)
  coveredCategories String[]
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  client          Client                   @relation(fields: [clientId], references: [id])
  history         ContractHistory[]
  monthlyBillings ContractMonthlyBilling[]
}

model ContractMonthlyBilling {
  id              String          @id @default(cuid())
  contractId      String
  clientId        String
  referenceMonth  Int
  referenceYear   Int
  amount          Decimal         @db.Decimal(12, 2)
  financialStatus FinancialStatus @default(PENDENTE)
  paidAt          DateTime?
  paymentMethod   String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contract        ClientContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id])

  @@unique([contractId, referenceYear, referenceMonth])
}

model ContractHistory {
  id         String         @id @default(cuid())
  contractId String
  authorId   String
  message    String
  createdAt  DateTime       @default(now())
  contract   ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  author     User           @relation(fields: [authorId], references: [id])
}

model BillingHistory {
  id              String                  @id @default(cuid())
  ticketBillingId  String
  authorId         String
  eventType        BillingHistoryEventType
  message          String
  createdAt        DateTime                @default(now())
  ticketBilling    TicketBilling           @relation(fields: [ticketBillingId], references: [id])
  author           User                    @relation(fields: [authorId], references: [id])
}

model RecurringExpense {
  id                 String             @id @default(cuid())
  description        String
  category           ExpenseCategory
  baseAmount         Decimal            @db.Decimal(12, 2)
  paymentMethod      String?
  frequency          RecurringFrequency @default(MENSAL)
  dayOfMonth         Int                @default(1)
  startDate          DateTime
  endDate            DateTime?
  active             Boolean            @default(true)
  notes              String?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  createdBy          User               @relation("RecurringExpenseCreator", fields: [createdById], references: [id])
  occurrences        Expense[]
}

model Expense {
  id                   String             @id @default(cuid())
  description          String
  category             ExpenseCategory
  amount               Decimal            @db.Decimal(12, 2)
  status               ExpenseStatus      @default(PENDENTE)
  expenseDate          DateTime
  paidAt               DateTime?
  paymentMethod        String?
  notes                String?
  ticketId             String?
  recurringExpenseId   String?
  referenceMonth       Int?
  referenceYear        Int?
  createdById          String
  cancellationReason   String?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  ticket               Ticket?            @relation(fields: [ticketId], references: [id])
  recurringExpense     RecurringExpense?  @relation(fields: [recurringExpenseId], references: [id])
  createdBy            User               @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([expenseDate, status])
  @@index([category])
  @@index([ticketId])
  @@index([recurringExpenseId, referenceYear, referenceMonth])
}

model Sale {
  id                 String          @id @default(cuid())
  number             String          @unique
  clientId           String
  financialStatus    FinancialStatus @default(PENDENTE)
  paymentMethod      String?
  paymentDate        DateTime?
  paymentReference   String?
  internalNotes      String?
  deliveryFee        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(12, 2)
  paidAt             DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  client             Client          @relation(fields: [clientId], references: [id])
  createdBy          User            @relation("SaleCreator", fields: [createdById], references: [id])
  items              SaleItem[]
  movements          StockMovement[]
  fiscalDocumentLinks FiscalDocumentLink[]
}

model SaleItem {
  id                String          @id @default(cuid())
  saleId            String
  partCatalogItemId String
  partName          String
  partCode          String?
  quantity          Decimal         @db.Decimal(10, 2)
  unitPrice         Decimal         @db.Decimal(12, 2)
  totalPrice        Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  sale              Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  partCatalogItem   PartCatalogItem @relation(fields: [partCatalogItemId], references: [id])
}

model StockMovement {
  id                 String            @id @default(cuid())
  partCatalogItemId  String
  type               StockMovementType
  quantity           Decimal           @db.Decimal(10, 2)
  saleId             String?
  serviceOrderPartId String?
  notes              String?
  createdById        String
  createdAt          DateTime          @default(now())
  part               PartCatalogItem   @relation(fields: [partCatalogItemId], references: [id])
  createdBy          User              @relation("StockMovementCreator", fields: [createdById], references: [id])
  sale               Sale?             @relation(fields: [saleId], references: [id])
}

model PaymentInstruction {
  id              String   @id @default(cuid())
  clientId        String?
  title           String
  paymentChannel  String
  pixKey          String?
  pixCopyPaste    String?
  qrCodeImagePath String?
  bankName        String?
  bankAgency      String?
  bankAccount     String?
  accountHolder   String?
  accountDocument String?
  notes           String?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId, active, sortOrder])
}

model FiscalDocument {
  id          String             @id @default(cuid())
  clientId    String
  type        FiscalDocumentType @default(OUTRO)
  number      String
  series      String?
  issueDate   DateTime
  totalAmount Decimal?           @db.Decimal(12, 2)
  fileName    String
  filePath    String
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  client      Client             @relation(fields: [clientId], references: [id])
  links       FiscalDocumentLink[]

  @@index([clientId, issueDate])
}

model Equipment {
  id              String          @id @default(cuid())
  model           String
  serialNumber    String?         @unique
  patrimonyCode   String?
  status          EquipmentStatus @default(DISPONIVEL)
  purchaseDate    DateTime?
  purchaseCost    Decimal?        @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  rentalItems     RentalContractItem[]
  tickets         Ticket[]        @relation("TicketEquipment")
}

model RentalContract {
  id                String               @id @default(cuid())
  contractNumber    String               @unique
  clientId          String
  status            RentalContractStatus @default(RASCUNHO)
  startDate         DateTime
  endDate           DateTime?
  noticeDays        Int                  @default(30)
  totalMonthlyValue Decimal              @default(0) @db.Decimal(12, 2)
  notes             String?
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  client            Client               @relation(fields: [clientId], references: [id])
  createdBy         User                 @relation("RentalContractCreator", fields: [createdById], references: [id])
  items             RentalContractItem[]
  billings          RentalBilling[]
}

model RentalContractItem {
  id               String         @id @default(cuid())
  rentalContractId String
  equipmentId      String
  monthlyPrice     Decimal        @db.Decimal(12, 2)
  installedAt      DateTime
  returnedAt       DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rentalContract   RentalContract @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)
  equipment        Equipment      @relation(fields: [equipmentId], references: [id])
}

model RentalBilling {
  id               String          @id @default(cuid())
  rentalContractId String
  clientId         String
  referenceMonth   Int
  referenceYear    Int
  amount           Decimal         @db.Decimal(12, 2)
  dueDate          DateTime?
  financialStatus  FinancialStatus @default(PENDENTE)
  paymentMethod    String?
  paymentDate      DateTime?
  paymentReference String?
  paidAt           DateTime?
  canceledAt       DateTime?
  notes            String?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  rentalContract   RentalContract  @relation(fields: [rentalContractId], references: [id], onDelete: Cascade)
  client           Client          @relation(fields: [clientId], references: [id])
  createdBy        User            @relation("RentalBillingCreator", fields: [createdById], references: [id])

  @@unique([rentalContractId, referenceYear, referenceMonth])
}

model FiscalDocumentLink {
  id               String         @id @default(cuid())
  fiscalDocumentId String
  ticketId         String?
  saleId           String?
  label            String?
  createdAt        DateTime       @default(now())
  fiscalDocument   FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)
  ticket           Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sale             Sale?          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([fiscalDocumentId])
  @@index([ticketId])
  @@index([saleId])
}
