generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ATTENDANT
  TECHNICIAN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  CANCELED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketAttendanceType {
  REMOTE
  INTERNAL
  IN_STORE_EQUIPMENT
  FIELD_VISIT
}

enum HistoryEventType {
  COMMENT
  STATUS_CHANGE
  PRIORITY_CHANGE
  ASSIGNEE_CHANGE
  CREATED
  CLOSED
  REOPENED
}

enum BillingType {
  AVULSO
  CONTRATO
  GARANTIA
  CORTESIA
}

enum FinancialStatus {
  PENDENTE
  EM_ANALISE
  APROVADO
  FATURADO
  PAGO
  CANCELADO
}

enum BillingEntryType {
  LABOR
  PART
  TRAVEL
  EXTRA
}

enum BillingHistoryEventType {
  SUMMARY_UPDATED
  ENTRY_CREATED
  ENTRY_UPDATED
  ENTRY_DELETED
  STATUS_UPDATED
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         UserRole
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assigned     Ticket[]        @relation("TicketAssignee")
  opened       Ticket[]        @relation("TicketCreator")
  history      TicketHistory[]
  billingEntries BillingEntry[]
  billingHistory BillingHistory[]
}

model Client {
  id             String   @id @default(cuid())
  name           String
  document       String?
  contactName    String
  email          String?
  phone          String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tickets        Ticket[]
  billingProfile ClientBillingProfile?
}

model Ticket {
  id              String          @id @default(cuid())
  number          String          @unique
  title           String
  description     String
  category        String?
  attendanceType  TicketAttendanceType @default(INTERNAL)
  priority        TicketPriority
  status          TicketStatus    @default(OPEN)
  requesterName   String
  requesterEmail  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?
  closingReason   String?
  clientId        String
  assigneeId      String?
  openedById      String
  client          Client          @relation(fields: [clientId], references: [id])
  assignee        User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  openedBy        User            @relation("TicketCreator", fields: [openedById], references: [id])
  history         TicketHistory[]
  attachments     Attachment[]
  billing         TicketBilling?
}

model TicketHistory {
  id                String           @id @default(cuid())
  ticketId          String
  authorId          String
  eventType         HistoryEventType
  message           String
  previousStatus    TicketStatus?
  nextStatus        TicketStatus?
  previousPriority  TicketPriority?
  nextPriority      TicketPriority?
  createdAt         DateTime         @default(now())
  ticket            Ticket           @relation(fields: [ticketId], references: [id])
  author            User             @relation(fields: [authorId], references: [id])
}

model Attachment {
  id         String   @id @default(cuid())
  ticketId   String
  fileName   String
  filePath   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
}

model TicketBilling {
  id             String           @id @default(cuid())
  ticketId        String           @unique
  billingType     BillingType      @default(AVULSO)
  financialStatus FinancialStatus  @default(PENDENTE)
  subtotalAmount  Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal          @default(0) @db.Decimal(12, 2)
  internalNotes   String?
  approvedAt      DateTime?
  invoicedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ticket          Ticket           @relation(fields: [ticketId], references: [id])
  entries         BillingEntry[]
  history         BillingHistory[]
}

model BillingEntry {
  id              String           @id @default(cuid())
  ticketBillingId String
  entryType       BillingEntryType
  description     String
  quantity        Decimal          @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal          @default(0) @db.Decimal(12, 2)
  totalPrice      Decimal          @default(0) @db.Decimal(12, 2)
  billable        Boolean          @default(true)
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ticketBilling   TicketBilling    @relation(fields: [ticketBillingId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
}

model ClientBillingProfile {
  id                     String       @id @default(cuid())
  clientId               String       @unique
  defaultBillingType     BillingType  @default(AVULSO)
  hourlyRate             Decimal?     @db.Decimal(12, 2)
  travelRate             Decimal?     @db.Decimal(12, 2)
  defaultDiscountPercent Decimal?     @db.Decimal(5, 2)
  hasActiveContract      Boolean      @default(false)
  contractNotes          String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  client                 Client       @relation(fields: [clientId], references: [id])
}

model BillingHistory {
  id              String                  @id @default(cuid())
  ticketBillingId  String
  authorId         String
  eventType        BillingHistoryEventType
  message          String
  createdAt        DateTime                @default(now())
  ticketBilling    TicketBilling           @relation(fields: [ticketBillingId], references: [id])
  author           User                    @relation(fields: [authorId], references: [id])
}
